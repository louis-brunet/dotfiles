{
  "$schema": "https://opencode.ai/config.json",
  // see https://models.dev for list
  "model": "github-copilot/gpt-5.6-terra",
  // "default_agent": "openagent",
  "share": "disabled",
  "autoupdate": "notify",
  "disabled_providers": [],
  "permission": {
    "bash": {
      "*": "ask",
      /** General bash commands considered safe */
      ".agents/skills/jira-api/scripts/jira-api issue get *": "allow",
      ".agents/skills/azure-devops-api/scripts/azure-devops-api *": "allow",
      "./.agents/skills/azure-devops-api/scripts/azure-devops-api *": "allow",
      "./azure-devops-api *": "allow",
      "aws --version": "allow",
      "aws configure list-profiles": "allow",
      "az ad sp show *": "allow",
      "az account show *": "allow",
      "az containerapp job execution list *": "allow",
      "az containerapp job execution show *": "allow",
      "az containerapp job logs show *": "allow",
      "az containerapp job replica list *": "allow",
      "az containerapp job show *": "allow",
      "az containerapp list *": "allow",
      "az devops configure --list": "allow",
      "az devops project show *": "allow",
      "az devops service-endpoint list *": "allow",
      "az extension list *": "allow",
      "az monitor activity-log list *": "allow",
      "az monitor log-analytics workspace list *": "allow",
      "az monitor log-analytics query *": "allow",
      "az monitor metrics list *": "allow",
      "az pipelines list *": "allow",
      "az pipelines runs list *": "allow",
      "az pipelines show *": "allow",
      "az resource list *": "allow",
      "az rest --method get *": "allow",
      "az role assignment list *": "allow",
      "az search service show *": "allow",
      "az storage account keys list *": "allow",
      "az storage account show *": "allow",
      "az storage account list *": "allow",
      "az storage blob list *": "allow",
      "az storage blob show *": "allow",
      "az storage container show *": "allow",
      "az storage message peek *": "allow",
      "az storage queue list *": "allow",
      "az storage queue show *": "allow",
      "az storage queue stats *": "allow",
      "az version *": "allow",
      "basename *": "allow",
      "brew list *": "allow",
      "cat *": "allow",
      "cut *": "allow",
      "curl -s \"https://context7.com/api*": "allow",
      "curl -s 'https://context7.com/api*": "allow",
      "date *": "allow",
      "diff *": "allow",
      "docker logs *": "allow",
      "docker ps *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "exit *": "allow",
      "file *": "allow",
      "find *": "allow",
      "fold *": "allow",
      "graphify *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "lsof *": "allow",
      "mise list *": "allow",
      "mkdir *": "allow",
      "netstat *": "allow",
      "nl *": "allow",
      "node --check *": "allow",
      "npm ci --ignore-scripts": "allow",
      "npm ls *": "allow",
      "playwright-cli *": "allow",
      "printf *": "allow",
      "ps *": "allow",
      "pwd": "allow",
      "python --version": "allow",
      "python3 --version": "allow",
      "readlink *": "allow",
      "rg *": "allow",
      "sample *": "allow",
      "sed *": "allow", // careful, can edit in place with `-i`
      "sleep *": "allow",
      "sort *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "tee *": "allow",
      "terraform fmt *": "allow",
      "terraform output *": "allow",
      "terraform plan *": "allow",
      "terraform show *": "allow",
      "terraform state list *": "allow",
      "terraform state show *": "allow",
      "terraform validate *": "allow",
      "terraform version": "allow",
      "test *": "allow",
      "tofu fmt *": "allow",
      "tofu output *": "allow",
      "tofu plan *": "allow",
      "tofu show *": "allow",
      "tofu state list *": "allow",
      "tofu state show *": "allow",
      "tofu validate *": "allow",
      "tofu version": "allow",
      "tree *": "allow",
      "tr *": "allow",
      "true": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "whoami": "allow",
      "xargs cat": "allow",
      "xargs grep *": "allow",
      "xargs ls *": "allow",
      /** TypeScript */
      "npx --version *": "allow",
      "npx eslint *": "allow",
      "npx jest *": "allow",
      "npx prettier *": "allow",
      "npx @nestjs/cli build *": "allow",
      "npx tsc *": "allow",
      "npx --no-install @angular/cli build *": "allow",
      "node --version": "allow",
      "npm --version": "allow",
      "npm audit *": "allow",
      "npm ci": "allow",
      "npm install": "allow",
      "npm exec tsc *": "allow",
      "npm run build *": "allow",
      "npm run test *": "allow",
      "npm run lint *": "allow",
      "npm run lint:fix *": "allow",
      "npm run typecheck *": "allow",
      "npm test *": "allow",
      "npm view *": "allow",
      "pnpm --version": "allow",
      "pnpm audit *": "allow",
      "pnpm config get *": "allow",
      "pnpm config list *": "allow",
      "pnpm exec prettier *": "allow",
      "pnpm exec prisma validate": "allow",
      "pnpm help *": "allow",
      "pnpm install": "allow",
      "pnpm peers check *": "allow",
      "pnpm root *": "allow",
      "pnpm run build *": "allow",
      "pnpm run test *": "allow",
      "pnpm run format:check *": "allow",
      "pnpm run lint *": "allow",
      "pnpm run lint:fix *": "allow",
      "pnpm run typecheck *": "allow",
      "pnpm store path *": "allow",
      "pnpm build *": "allow",
      "pnpm format:check *": "allow",
      "pnpm lint *": "allow",
      "pnpm lint:fix *": "allow",
      "pnpm list *": "allow",
      "pnpm test *": "allow",
      "pnpm typecheck *": "allow",
      "yarn --version *": "allow",
      "yarn -v *": "allow",
      "yarn audit *": "allow",
      "yarn install": "allow",
      "yarn run build *": "allow",
      "yarn run format:check *": "allow",
      "yarn run lint *": "allow",
      "yarn run lint:fix *": "allow",
      "yarn run test *": "allow",
      "yarn run typecheck *": "allow",
      "yarn build *": "allow",
      "yarn format:check *": "allow",
      "yarn lint *": "allow",
      "yarn lint:fix *": "allow",
      "yarn test *": "allow",
      "yarn typecheck *": "allow",
      "yarn why *": "allow",
      /** Python */
      "uv --version": "allow",
      "uv run pytest *": "allow",
      "uv run ruff *": "allow",
      "uv run mypy *": "allow",
      "uv run alembic check *": "allow",
      "uv run alembic current *": "allow",
      "uv run alembic heads *": "allow",
      "uv run alembic history *": "allow",
      "uv sync": "allow",
      /** NOTE: order matters, the last rule wins. So `ask`/`deny` configs should go towards the end. */
      "rm *": "ask",
      /* git */
      "git *": "ask",
      /* git: allow list */
      "git blame *": "allow",
      "git branch --list *": "allow",
      "git branch --show-current": "allow",
      "git branch -a": "allow",
      "git branch -vv": "allow",
      "git branch -avv --no-abbrev": "allow",
      "git cat-file *": "allow",
      "git check-ignore *": "allow",
      "git diff *": "allow",
      "git diff-tree *": "allow",
      "git fetch *": "allow",
      "git grep *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git ls-remote *": "allow",
      "git ls-tree *": "allow",
      "git merge-base *": "allow",
      "git merge-tree *": "allow",
      "git reflog *": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",
      "git range-diff *": "allow",
      "git rev-list *": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git stash list": "allow",
      "git status *": "allow",
      "git worktree list *": "allow",
      /* git: ask */
      "git checkout *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "git stash *": "ask",
      /* gcloud */
      "gcloud iam roles describe *": "allow",
      "gcloud iam roles list *": "allow",
      "gcloud version": "allow",
      /* DENY */
      "sudo *": "deny"
    },
    "edit": {
      "**/*.env": "ask",
      "**/package.json": "ask",
      "**/pyproject.toml": "ask",
      "**/node_modules/**": "deny",
      "**/__pycache__/**": "deny",
      "**/*.pyc": "deny",
      ".git/**": "deny",
      "**/dist/**": "deny",
      "**/build/**": "deny"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "plugin": [
    // "cc-safety-net"
    // "@spoons-and-mirrors/subtask2@latest"
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": false,
      "environment": {}
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "environment": {},
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": false
    }
    // "figma": {
    //   "type": "remote",
    //   "url": "https://mcp.figma.com/mcp",
    //   "enabled": true,
    //   "oauth": {}
    // }
  },
  "provider": {
    "neptune-bedrock": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:4000/v1"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5 (Neptune)",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6 (Neptune)",
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        }
      }
    },
    "azure-rfp-assistant": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://fr-rfpass1455-foundry-dev-tmp.services.ai.azure.com/openai/v1"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna (RFP Assistant)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "output": 128000,
            "context": 1050000
          }
        },
        "gpt-6-luna": {
          "name": "GPT 6 Luna (RFP Assistant)",
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "output": 128000,
            "context": 1050000
          }
        }
      }
    }
    // "azure-azp-dar": {
    //   "npm": "@ai-sdk/openai-compatible",
    //   "options": {
    //     // "apiKey": "your-api-key",
    //     "baseURL": "https://azp-dar-ai-foundry-france-npd.openai.azure.com/openai/v1"
    //   },
    //   "models": {
    //     "kimi-k2.6": {
    //       "name": "Kimi K2.6",
    //       "limit": {
    //         "output": 262144,
    //         "context": 262144
    //       }
    //     },
    //     "Kimi-K2.7-Code": {
    //       "name": "Kimi K2.7 Code",
    //       "limit": {
    //         "output": 262144,
    //         "context": 262144
    //       }
    //     }
    //   }
    // }
  },
  "agent": {}
}
